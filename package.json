{
  "name": "knx-frontend",
  "version": "0.0.1",
  "description": "Home Assistant custom panel for the KNX integration",
  "source": "src/entrypoint.ts",
  "main": "build/entrypoint.js",
  "scripts": {
    "develop": "./script/develop",
    "build": "./script/build",
    "build:size": "node build-scripts/report-output-size.cjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint:eslint": "eslint \"./src/**/*.{js,ts,html}\" \"./gallery/**/*.ts\" --ignore-pattern .gitignore --ignore-pattern '**/.worktrees/**' --max-warnings=0",
    "format:eslint": "eslint \"./src/**/*.{js,ts,html}\" \"./gallery/**/*.ts\" --fix --ignore-pattern .gitignore --ignore-pattern '**/.worktrees/**'",
    "lint:prettier": "prettier \"./src/**/*.{js,ts,json,css,md}\" \"./gallery/**/*.{ts,json,html,css,mjs,cjs,md}\" \"!**/.worktrees/**\" --check",
    "format:prettier": "prettier \"./src/**/*.{js,ts,json,css,md}\" \"./gallery/**/*.{ts,json,html,css,mjs,cjs,md}\" \"!**/.worktrees/**\" --write",
    "lint:types": "tsc --project tsconfig.json",
    "lint:lit": "lit-analyzer \"{src,gallery/src}/**/*.ts\"",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier && pnpm run lint:types && pnpm run lint:lit && pnpm run gallery:lint:tools",
    "format": "pnpm run format:eslint && pnpm run format:prettier",
    "agent:claude": "ln -sf .github/copilot-instructions.md CLAUDE.md",
    "agent:gemini": "ln -sf .github/copilot-instructions.md GEMINI.md",
    "agent:codex": "ln -sf .github/copilot-instructions.md AGENTS.md",
    "postinstall": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable",
    "gallery": "node gallery/script/gallery.mjs develop",
    "gallery:build": "node gallery/script/gallery.mjs build && pnpm gallery:thumbnails",
    "gallery:thumbnails": "playwright test --config gallery/test/playwright.gallery-thumbnails.config.ts",
    "gallery:test": "playwright test --config gallery/test/playwright.gallery.config.ts",
    "gallery:lint": "eslint \"gallery/**/*.ts\" --max-warnings=0 && prettier \"gallery/**/*.{ts,json,html,css,mjs,cjs,md}\" --check && pnpm gallery:lint:tools && lit-analyzer \"gallery/src/**/*.ts\"",
    "gallery:unit": "vitest run --config vitest.config.ts --dir gallery",
    "gallery:types": "tsc --project gallery/tsconfig.json",
    "gallery:policy": "python3 -m unittest discover -s gallery/test -p 'test_gallery_pages*.py'",
    "gallery:lint:tools": "node --check gallery/script/gallery.mjs && node --check gallery/script/gallery-brands-url-loader.cjs && node --check gallery/script/check-gallery-exclusion.mjs"
  },
  "repository": "https://github.com/XKNX/knx-frontend.git",
  "author": "Marvin Wichmann <me@marvin-wichmann.de>",
  "license": "MIT",
