#!/bin/sh
# Resolve all frontend dependencies that the application requires to develop.

# Stop on errors
set -e

cd "$(dirname "$0")/.."

if [ ! -d "./homeassistant-frontend/src" ]; then
  cd homeassistant-frontend
  git submodule init
  git submodule update
  cd ..
fi

if [ -n "$DEVCONTAINER" ] && ! command -v pnpm > /dev/null 2>&1; then
  npm install -g corepack
  corepack enable pnpm
fi

if ! command -v pnpm > /dev/null 2>&1; then
  echo "Error: pnpm not found. Enable it with \`corepack enable pnpm\` or follow https://pnpm.io/installation" >&2
  exit 1
fi

pnpm install